<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F6F6F6">

    <ScrollView
        android:id="@+id/productScroll"
        android:layout_width="0dp"
        android:layout_height="0dp"

        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@id/sizeContainer"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:orientation="vertical"
            android:padding="20dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">


            <TextView
                android:text="NEW"
                android:textSize="12sp"
                android:textStyle="bold"
                android:textColor="@android:color/white"
                android:padding="6dp"
                android:background="@drawable/new_badge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>


            <ImageView
                android:id="@+id/detailImage"
                android:layout_width="match_parent"
                android:layout_height="260dp"
                android:layout_marginTop="14dp"
                android:scaleType="centerInside"/>


            <TextView
                android:id="@+id/detailTitle"
                android:textSize="22sp"
                android:textStyle="bold"
                android:textColor="#222222"
                android:layout_marginTop="18dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>


            <TextView
                android:id="@+id/detailDescription"
                android:textSize="15sp"
                android:textColor="#777777"
                android:layout_marginTop="6dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>

        </LinearLayout>

    </ScrollView>


    <!-- КНОПКИ РАЗМЕРОВ -->

    <LinearLayout
        android:id="@+id/sizeContainer"
        android:layout_width="0dp"
        android:layout_height="wrap_content"

        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingBottom="10dp"

        app:layout_constraintBottom_toTopOf="@id/addToCart"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <Button style="@style/SizeButton" android:id="@+id/sizeXXS" android:text="XXS"/>
        <Button style="@style/SizeButton" android:id="@+id/sizeXS" android:text="XS"/>
        <Button style="@style/SizeButton" android:id="@+id/sizeS" android:text="S"/>
        <Button style="@style/SizeButton" android:id="@+id/sizeM" android:text="M"/>
        <Button style="@style/SizeButton" android:id="@+id/sizeL" android:text="L"/>
        <Button style="@style/SizeButton" android:id="@+id/sizeXL" android:text="XL"/>

    </LinearLayout>
    <Button
        android:id="@+id/addToCart"
        android:layout_width="0dp"
        android:layout_height="60dp"
        android:text="В корзину"
        android:textColor="@android:color/white"
        android:textSize="16sp"
        android:backgroundTint="#8B5E3C"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_margin="16dp"/>

</androidx.constraintlayout.widget.ConstraintLayout>