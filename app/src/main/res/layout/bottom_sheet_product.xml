<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/rounded_top_sheet">

    <ScrollView
        android:id="@+id/productScroll"
        android:layout_width="0dp"
        android:layout_height="0dp"


        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@id/sizeContainer"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:orientation="vertical"
            android:padding="20dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">


            <TextView
                android:text="NEW"
                android:textSize="11dp"
                android:textStyle="bold"
                android:textAlignment="center"
                android:textColor="@android:color/white"
                android:padding="4dp"
                android:background="@drawable/new_badge"
                android:layout_width="44dp"
                android:layout_height="24dp"/>


            <ImageView
                android:id="@+id/detailImage"
                android:layout_width="match_parent"
                android:layout_height="180dp"
                android:layout_marginTop="14dp"
                android:scaleType="centerInside"/>


            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp">

                <TextView
                    android:id="@+id/detailTitle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:textSize="22sp"
                    android:textStyle="bold"
                    android:textColor="#222222"

                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toStartOf="@id/infoButton"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent"/>

                <Button
                    android:id="@+id/infoButton"
                    android:layout_width="30dp"
                    android:layout_height="30dp"
                    android:text="i"
                    android:textAllCaps="false"
                    android:backgroundTint="#F6EFEB"
                    android:textColor="#A47764"
                    android:background="@drawable/rounded_ui"

                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent"/>

            </androidx.constraintlayout.widget.ConstraintLayout>


            <TextView
                android:id="@+id/detailDescription"
                android:textSize="15sp"
                android:textColor="#777777"
                android:layout_marginTop="6dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>

        </LinearLayout>

    </ScrollView>


    <!-- КНОПКИ РАЗМЕРОВ -->

    <LinearLayout
        android:id="@+id/sizeContainer"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"



        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingBottom="10dp"

        app:layout_constraintBottom_toTopOf="@id/addToCart"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <Button style="@style/SizeButton" android:id="@+id/sizeXXS" android:text="XXS"/>
        <Button style="@style/SizeButton" android:id="@+id/sizeXS" android:text="XS"/>
        <Button style="@style/SizeButton" android:id="@+id/sizeS" android:text="S"/>
        <Button style="@style/SizeButton" android:id="@+id/sizeM" android:text="M"/>
        <Button style="@style/SizeButton" android:id="@+id/sizeL" android:text="L"/>
        <Button style="@style/SizeButton" android:id="@+id/sizeXL" android:text="XL"/>

    </LinearLayout>
    <Button
        android:id="@+id/addToCart"
        android:layout_width="0dp"
        android:layout_height="50dp"
        android:text="В корзину"
        android:textColor="@android:color/white"
        android:textSize="16sp"
        android:textFontWeight="600"
        android:textAllCaps="false"
        android:backgroundTint="#A47764"
        android:background="@drawable/rounded_ui_cart_button"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_margin="16dp"/>

</androidx.constraintlayout.widget.ConstraintLayout>